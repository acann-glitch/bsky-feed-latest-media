# Port the server listens on (Railway sets this automatically)
PORT=3000

# The public hostname Railway assigns your app (e.g. my-feed.up.railway.app)
FEEDGEN_HOSTNAME=your-app.up.railway.app

# The DID for this feed generator service — uses did:web by default
# Leave blank and it will be auto-derived from FEEDGEN_HOSTNAME
FEEDGEN_SERVICE_DID=

# Your personal Bluesky DID (find it at https://bsky.app → Settings → Privacy and Security)
FEEDGEN_PUBLISHER_DID=did:plc:xxxxxxxxxxxxxxxxxxxx

# Your Bluesky handle and an App Password (Settings → Privacy and Security → App Passwords)
BSKY_IDENTIFIER=yourhandle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
